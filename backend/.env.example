PORT=5000
NODE_ENV=production

# ARMS server credentials - DO NOT commit real values to Git.
ARMS_BASE_URL=https://hasani.arms.com.my
ARMS_USERNAME=YOUR_ARMS_USERNAME
ARMS_PASSWORD=YOUR_ARMS_PASSWORD
ARMS_LOGIN_BRANCH=HQ
ARMS_TNC=1
ARMS_TIMEOUT_MS=20000
ARMS_SESSION_MAX_AGE_MS=1200000

# Customer application password.
# Membership numbers are ALWAYS verified against ARMS before login.
CUSTOMER_PASSWORD=123123

# Customer session security.
CUSTOMER_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
CUSTOMER_SESSION_COOKIE=hasani_customer_sid
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
FRONTEND_ORIGIN=https://your-customer-portal.example.com
ENABLE_ARMS_DIAGNOSTICS=false

# Verified live ARMS history request captured from DevTools.
ARMS_HISTORY_URL_TEMPLATE=/membership.php?t=history&a=i&nric={membership}

# ARMS purchase detail enrichment. ARMS history rows contain trans_detail(...)
# parameters; the backend follows those links automatically.
ARMS_FETCH_TRANSACTION_DETAILS=true
ARMS_TRANSACTION_DETAIL_LIMIT=20

# Optional online store URL.
ONLINE_STORE_URL=

# Diagnostic transaction mapping (not used by customer login).
ARMS_TEST_BRANCH_ID=12
ARMS_TEST_COUNTER_ID=46
ARMS_TEST_POS_ID=202
ARMS_TEST_CASHIER_ID=48
ARMS_TEST_DATE=2026-05-16
